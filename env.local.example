# Agora credentials
# Required: found in Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=

# Required: found in Agora Console → your project → "App Certificate"
# Server-side only. Never expose this in client code.
NEXT_AGORA_APP_CERTIFICATE=

# Required for OpenAI GPT Live. Server-side only.
NEXT_OPENAI_API_KEY=

# Optional opening line. Defaults to Ada's built-in greeting. Server-side only.
# NEXT_AGENT_GREETING=

# Optional persistent behavior guidance for GPT Live. Defaults to the built-in Ada persona. Server-side only.
# AGENT_INSTRUCTIONS=

# Optional prior conversation (JSON); separate from AGENT_INSTRUCTIONS.
# AGENT_PRIOR_MESSAGES='[{"role":"user","content":"I am planning a trip to Kyoto."},{"role":"assistant","content":"How many days will you be staying?"},{"role":"user","content":"Three days. I enjoy gardens and local food."}]'
